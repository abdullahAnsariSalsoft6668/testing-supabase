# Supabase — reads root .env automatically (EXPO_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_KEY)
# Or set these names here for API-only overrides:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your_supabase_service_role_or_anon_key

# Optional — enables OpenAI for general health Q&A (booking flow stays rule-based)
OPENAI_API_KEY=

# Server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
