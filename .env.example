EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_KEY=your_supabase_anon_key

# FastAPI AI backend (optional — app falls back to local alpha if unset or unreachable)
# Prefer 127.0.0.1 + `yarn node:reverse` (USB device and emulator).
# Without reverse — emulator: http://10.0.2.2:8000 | physical Wi‑Fi: http://YOUR_MAC_IP:8000
EXPO_PUBLIC_AI_API_BASE_URL=http://127.0.0.1:8000

# Retell voice backend (Node.js)
# Production: https://YOUR_RAILWAY_APP.up.railway.app
# Local dev: http://127.0.0.1:3001 + `yarn node:reverse`
EXPO_PUBLIC_NODE_API_BASE_URL=https://testing-supabase-production.up.railway.app
RETELL_API_KEY=your_retell_api_key
RETELL_AGENT_ID=agent_xxxxxxxx
