# Retell (https://dashboard.retellai.com)
RETELL_API_KEY=your_retell_api_key
RETELL_AGENT_ID=agent_xxxxxxxx

# Supabase — use the SECRET / service_role key (bypasses RLS). Never use publishable/anon here.
# Dashboard → Project Settings → API → service_role or sb_secret_...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_sb_secret_key

# Fallback only (RLS applies): root EXPO_PUBLIC_SUPABASE_* — not enough for Retell booking
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_KEY=

PORT=3001
CORS_ORIGINS=*

# Set to "false" for local/ngrok without signature verification
VERIFY_RETELL_SIGNATURE=false

# Retell dashboard Test Audio — fallback patient when call.metadata is empty
# RETELL_TEST_PATIENT_ID=6c0f9d00-6651-4e74-8ff8-3ca5a0fbd912
RETELL_TEST_PATIENT_EMAIL=user1@mailinator.com

# Twilio SMS (booking confirmation). Patient phone must be E.164 (+…).
# Trial: verify the recipient in Twilio; custom text is blocked — Node falls back to sms_appointment_reminders.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# When users.phone has no +, treat 10-digit numbers as this country (1 = US, 92 = Pakistan)
TWILIO_DEFAULT_COUNTRY=1

# Outbound 24h reminder (Retell phone call). Talk to AI still uses RETELL_AGENT_ID.
# Run supabase/migrations/022_appointment_reminder_call.sql in the SQL Editor.
RETELL_REMINDER_AGENT_ID=agent_xxxxxxxx
RETELL_FROM_NUMBER=+1xxxxxxxxxx
REMINDER_ENABLED=true
# Fallback only if a hospital has no timezone and its address has no US state.
# Each clinic uses hospitals.timezone (Admin → Hospitals). Run migration 023.
REMINDER_TIMEZONE=America/New_York
REMINDER_LEAD_MINUTES=1440
# Test: REMINDER_LEAD_MINUTES=5 and REMINDER_POLL_MS=15000
# REMINDER_WINDOW_MINUTES=60
# REMINDER_POLL_MS=600000
