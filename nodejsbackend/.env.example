# Retell (https://dashboard.retellai.com)
RETELL_API_KEY=your_retell_api_key
RETELL_AGENT_ID=agent_xxxxxxxx

# Supabase — use the SECRET / service_role key (bypasses RLS). Never use publishable/anon here.
# Dashboard → Project Settings → API → service_role or sb_secret_...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_sb_secret_key

# Fallback only (RLS applies): root EXPO_PUBLIC_SUPABASE_* — not enough for Retell booking
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_KEY=

PORT=3001
CORS_ORIGINS=*

# Set to "false" for local/ngrok without signature verification
VERIFY_RETELL_SIGNATURE=false
