# Retell (https://dashboard.retellai.com)
RETELL_API_KEY=your_retell_api_key
RETELL_AGENT_ID=agent_xxxxxxxx

# Supabase — reads project root .env if these are unset
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Or use same names as mobile app (loaded from ../.env automatically)
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_KEY=

PORT=3001
CORS_ORIGINS=*

# Set to "false" to skip Retell signature check in local dev
VERIFY_RETELL_SIGNATURE=true
