VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Copy from repo root .env:
# VITE_SUPABASE_URL=<same as EXPO_PUBLIC_SUPABASE_URL>
# VITE_SUPABASE_ANON_KEY=<same as EXPO_PUBLIC_SUPABASE_KEY>
# Node backend — required for booking SMS (POST /notify/booking-sms). Node must be running.
VITE_NODE_API_BASE_URL=http://127.0.0.1:3001
