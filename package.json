{
  "name": "ultimategrocery",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "api:dev": "cd api && .venv/bin/python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "api:install": "cd api && python3.13 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "node:dev": "cd nodejsbackend && npm run dev",
    "node:install": "cd nodejsbackend && npm install",
    "node:reverse": "adb reverse tcp:3001 tcp:3001 && adb reverse tcp:8000 tcp:8000",
    "web:dev": "cd webpanel && npm run dev",
    "web:build": "cd webpanel && npm run build",
    "web:install": "cd webpanel && npm install",
    "clean": "cd android && ./gradlew clean && cd ..",
    "postinstall": "patch-package",
    "mobile": "adb -s 8BEY0YD9Y reverse tcp:8081 tcp:8081 && yarn run start",
    "generate:screen": "ts-node src/customscripts/generate-screen.ts",
    "generate:screen:watch": "ts-node src/customscripts/generate-screen.ts --watch",
    "delete:screen": "ts-node src/customscripts/delete-screen.ts",
    "generate:icons": "ts-node src/customscripts/generate-icons.ts",
    "generate:icons:watch": "ts-node src/customscripts/generate-icons.ts --watch",
    "generate:images": "ts-node src/customscripts/generate-images.ts",
    "generate:images:watch": "ts-node src/customscripts/generate-images.ts --watch",
    "localApk": "react-native run-android --mode=release",
    "apk": "cd android && ./gradlew clean && ./gradlew assembleRelease",
    "fonts": "npx react-native-asset"
  },
  "dependencies": {
    "@livekit/react-native": "^2.11.1",
    "@livekit/react-native-webrtc": "^144.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
